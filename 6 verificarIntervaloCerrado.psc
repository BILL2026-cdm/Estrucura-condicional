Algoritmo verificarIntervaloCerrado
    Definir x, minimoValor, maximoValor Como entero
    Escribir "Ingrese número x"
    Leer x
    Escribir "Ingrese valor mínimo del intervalo"
    Leer minimoValor
    Escribir "Ingrese valor máximo del intervalo"
    Leer maximoValor
    Si x >= minimoValor Y x <= maximoValor Entonces
        Escribir "El número está DENTRO del intervalo cerrado"
    Sino
        Escribir "El número está FUERA del intervalo cerrado"
    FinSi
FinAlgoritmo